  "styles": {
    "color": {
      "background": "#0c0c0d",
      "text": "#f2f0eb"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|manrope",
      "fontSize": "17px",
      "lineHeight": "1.7"
    },
    "spacing": {
      "blockGap": "1.2rem"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|playfair",
          "fontWeight": "500",
          "lineHeight": "1.12"
        }
      },
      "link": {
        "color": { "text": "inherit" }
      },
      "button": {
        "color": { "background": "#26c9ff", "text": "#06141a" },
        "border": { "radius": "999px" },
        "typography": { "fontFamily": "var:preset|font-family|manrope", "fontSize": "15px", "fontWeight": "700" },
        "spacing": { "padding": { "top": "15px", "bottom": "15px", "left": "28px", "right": "28px" } }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
